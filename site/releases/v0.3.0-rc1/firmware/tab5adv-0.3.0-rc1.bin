␀␀␀␀  -m, --music-volume=NUM   Set the music volume, 0-255 (default: 192)
  -s, --sfx-volume=NUM     Set the sfx volume, 0-255 (default: 192)
  -r, --speech-volume=NUM  Set the speech volume, 0-255 (default: 192)
  --midi-gain=NUM          Set the gain for MIDI playback, 0-1000 (default:
                           100) (only supported by some MIDI drivers)
  -n, --subtitles          Enable subtitles (use with games that have voice)
  -b, --boot-param=NUM     Pass number to the boot script (boot param)
  -d, --debuglevel=NUM     Set debug verbosity level
  --debugflags=FLAGS       Enable engine specific debug flags
                           (separated by commas)
  --debug-channels-only    Show only the specified debug channels
  -u, --dump-scripts       Enable script dumping if a directory called 'dumps'
                           exists in the current directory

  --cdrom=DRIVE            CD drive to play CD audio from; can either be a
                           drive, path, or numeric index (default: 0 = best
                           choice drive)
  --joystick[=NUM]         Enable joystick input (default: 0 = first joystick)
  --savepath=PATH          Path to where saved games are stored
  --extrapath=PATH         Extra path to additional game data
  --iconspath=PATH         Path to additional icons for the launcher grid view
  --soundfont=FILE         Select the SoundFont for MIDI playback (only
                           supported by some MIDI drivers)
  --multi-midi             Enable combination AdLib and native MIDI
  --native-mt32            True Roland MT-32 (disable GM emulation)
  --dump-midi              Dumps MIDI events to 'dump.mid', until quitting from game
                           (if file already exists, it will be overwritten)
  --enable-gs              Enable Roland GS mode for MIDI playback
  --output-channels=CHANNELS Select output channel count (e.g. 2 for stereo)
  --output-rate=RATE       Select output sample rate in Hz (e.g. 22050)
  --opl-driver=DRIVER      Select AdLib (OPL) emulator (db, mame)
  --show-fps               Set the turn on display FPS info in 3D games
  --no-show-fps            Set the turn off display FPS info in 3D games
  --random-seed=SEED       Set the random seed used to initialize entropy
  --renderer=RENDERER      Select 3D renderer (software, opengl, opengl_shaders)
  --aspect-ratio           Enable aspect ratio correction
  --[no-]dirtyrects        Enable dirty rectangles optimisation in software renderer
                           (default: enabled)
  --render-mode=MODE       Enable additional render modes (hercGreen, hercAmber,
                           cga, ega, vga, amiga, fmtowns, pc98-256c, pc98-16c, pc98-8c, 2gs,
                           atari, macintosh, macintoshbw, vgaGray)

  --alt-intro              Use alternative intro for CD versions of Beneath a
                           Steel Sky and Flight of the Amazon Queen
  --copy-protection        Enable copy protection in games, when
                           ScummVM disables it by default.
  --talkspeed=NUM          Set talk speed for games (default: 60)
                           Grim Fandango or EMI (default: 179).
  --demo-mode              Start demo mode of Maniac Mansion or The 7th Guest
  --tempo=NUM              Set music tempo (in percent, 50-200) for SCUMM games
                           (default: 100)
  --engine-speed=NUM       Set frame per second limit (0 - 100), 0 = no limit
                           (default: 60)
                           Grim Fandango or Escape from Monkey Island
  --md5                    Shows MD5 hash of the file given by --md5-path=PATH
                           If --md5-length=NUM is passed then it shows the MD5 hash of
                           the first or last NUM bytes of the file given by PATH
                           If --md5-engine=ENGINE_ID is passed, it fetches the MD5 length
                           automatically, overriding --md5-length
  --md5mac                 Shows MD5 hash for both the resource fork and data fork of the
                           mac file given by --md5-path=PATH. If --md5-length=NUM is passed
                           then it shows the MD5 hash of the first or last NUM bytes of each
                           fork.
  --md5-path=PATH          Used with --md5 or --md5mac to specify path of file to calculate
                           MD5 hash of
  --md5-length=NUM         Used with --md5 or --md5mac to specify the number of bytes to be
                           hashed. Use negative number for calculating tail md5.
                           Is overriden when used with --md5-engine
  --md5-engine=ENGINE_ID   Used with --md5 to specify the engine for which number of bytes
                           to be hashed must be calculated. This option overrides --md5-length
                           if used along with it. Use --list-engines to find all engineIds

