index 00000000..5a4752bc
--- /dev/null
+++ b/backends/platform/esp32/main/tab5-controls.h
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+namespace Tab5 {
+enum class Action { Move, LeftDown, LeftUp, RightDown, RightUp, Menu, EscapeDown, EscapeUp, Keyboard, VolumeDown, VolumeUp, Mute };
+struct Event { Action action; int x; int y; };
+enum class Zone { None, Scene, Left, Right, Hover, Menu, Skip, Keys, Overlay, VolumeDown, VolumeUp, Mute };
+struct Button { Zone zone; int x,y,w,h; const char *label; };
+static constexpr Button buttons[] = {
+	{Zone::Left, 12, 150, 136, 96, "LEFT"},
+	{Zone::Right,12, 272, 136, 96, "RIGHT"},
+	{Zone::Hover,12,394,136,96,"MOVE"},
+	{Zone::Menu,1132,150,136,96,"MENU"},
+	{Zone::Skip,1132,272,136,96,"SKIP"},
+	{Zone::Keys,1132,394,136,96,"KEYS"},
+    {Zone::VolumeDown,12,512,136,96,"-"},
+    {Zone::VolumeUp,12,614,136,96,"+"},
+    {Zone::Mute,1132,548,136,96,"MUTE"}
+};
+struct AudioState {
+    int volume=70;
+    bool muted=false;
+    void changeVolume(int delta) { volume+=delta; if(volume<0)volume=0;if(volume>100)volume=100; }
+    void toggleMute() { muted=!muted; }
+};
+struct Viewport {
+    int gameW=320, gameH=200;
+    int x=160, y=4, w=960, h=712;
+    static Viewport forGame(int width,int height) {
+        Viewport v; v.gameW=width; v.gameH=height;
+        if(width==320 && height==200) return v; // DOS pixel aspect correction.
+        int sx16=960*16/width, sy16=720*16/height;
+        int scale16=sx16<sy16?sx16:sy16;
+        v.w=width*scale16/16; v.h=height*scale16/16;
+        v.x=(1280-v.w)/2; v.y=(720-v.h)/2; return v;
+    }
+};
+inline Zone zoneAt(int x,int y,const Viewport &v=Viewport{}) {
+	if (x>=v.x && x<v.x+v.w && y>=v.y && y<v.y+v.h) return Zone::Scene;
+	for (const auto &b:buttons)
+		if(x>=b.x && x<b.x+b.w && y>=b.y && y<b.y+b.h) return b.zone;
+	return Zone::None;
+}
+
+// Fixed event batch: a drag release followed by a click needs at most four.
+class Input {
+public:
+	int cursorX=160, cursorY=100;
+    Viewport viewport;
+    void setGameSize(int w,int h) { viewport=Viewport::forGame(w,h); cursorX=w/2;cursorY=h/2; _held=_rightHeld=_contact=_multi=false;_heldZone=Zone::None;_read=_count=0; hoverOnly=false; }
+	bool hoverOnly=false;
+	bool next(Event &event) { if (_read==_count) return false; event=_events[_read++]; return true; }
+	void sample(int fingers,int rawX,int rawY,bool overlay) {
+		_read=_count=0;
+		if (!fingers) { release(); _contact=false; _multi=false; return; }
+		if (fingers>1) {
+			release();
+			if(fingers==2 && !_multi) emit(Action::Keyboard,_lastX,_lastY);
+			_multi=true; _contact=true; return;
+		}
+		if (_multi) return; // Lift all fingers before returning to a one-finger gesture.
+		int x=1279-rawY, y=rawX;
+		Zone zone=overlay ? Zone::Overlay : zoneAt(x,y,viewport);
+		bool fresh=!_contact; _contact=true;
+        if (_heldZone != Zone::None) {
+            if (zone == _heldZone) return; // Keep the button down while the finger remains on it.
+            release();
+        }
+		if(zone==Zone::Scene || zone==Zone::Overlay) {
+			if(!overlay) { x=(x-viewport.x)*viewport.gameW/viewport.w; y=(y-viewport.y)*viewport.gameH/viewport.h; cursorX=x; cursorY=y; }
+			_lastX=x; _lastY=y; emit(Action::Move,x,y);
+			if(fresh && (overlay || !hoverOnly)) { emit(Action::LeftDown,x,y); _held=true; }
+			return;
+		}
+		release();
+		if(!fresh) return; // Dragging into a rail must not activate its buttons.
+		switch(zone) {
+		case Zone::Left: press(false); break;
+		case Zone::Right: press(true); break;
+		case Zone::Hover: hoverOnly=!hoverOnly; break;
+		case Zone::Menu: emit(Action::Menu,cursorX,cursorY); break;
+		case Zone::Skip: emit(Action::EscapeDown,cursorX,cursorY); emit(Action::EscapeUp,cursorX,cursorY); break;
+		case Zone::Keys: emit(Action::Keyboard,cursorX,cursorY); break;
+        case Zone::VolumeDown: emit(Action::VolumeDown,cursorX,cursorY); break;
+        case Zone::VolumeUp: emit(Action::VolumeUp,cursorX,cursorY); break;
+        case Zone::Mute: emit(Action::Mute,cursorX,cursorY); break;
+		default: break;
+		}
+	}
+private:
+	Event _events[4]; int _read=0,_count=0;
+	int _lastX=160,_lastY=100;
+	bool _held=false,_rightHeld=false,_contact=false,_multi=false;
+    Zone _heldZone=Zone::None;
+	void emit(Action a,int x,int y) { if(_count<4) _events[_count++]={a,x,y}; }
+	void release() {
+        if(_held) { emit(Action::LeftUp,_lastX,_lastY); _held=false; }
+        if(_rightHeld) { emit(Action::RightUp,_lastX,_lastY); _rightHeld=false; }
+        _heldZone=Zone::None;
+    }
+	void press(bool right) {
+        _lastX=cursorX;_lastY=cursorY;
+        _held=!right;_rightHeld=right;_heldZone=right?Zone::Right:Zone::Left;
+		emit(Action::Move,cursorX,cursorY);
+		emit(right?Action::RightDown:Action::LeftDown,cursorX,cursorY);
+	}
+};
+}
