+}
+static constexpr uint8_t digits[10][7]={
+ {14,17,19,21,25,17,14},{4,12,4,4,4,4,14},{14,17,1,2,4,8,31},
+ {30,1,1,14,1,1,30},{2,6,10,18,31,2,2},{31,16,16,30,1,1,30},
+ {14,16,16,30,17,17,14},{31,1,2,4,8,8,8},{14,17,17,14,17,17,14},
+ {14,17,17,15,1,1,14}
+};
+inline void text(uint16_t *out,const char *s,int x,int y,int scale,uint16_t c) {
+    static const uint8_t plus[7]={0,4,4,31,4,4,0}, minus[7]={0,0,0,31,0,0,0}, percent[7]={17,18,2,4,8,9,17};
+    for(;*s;++s,x+=6*scale) {
+        const uint8_t *glyph=nullptr;
+        if(*s>='A'&&*s<='Z')glyph=letters[*s-'A'];
+        else if(*s>='0'&&*s<='9')glyph=digits[*s-'0'];
+        else if(*s=='+')glyph=plus;else if(*s=='-')glyph=minus;else if(*s=='%')glyph=percent;
+        if(!glyph)continue;
+        for(int row=0;row<7;++row)for(int col=0;col<5;++col)
+            if(glyph[row]&(1<<(4-col)))rect(out,x+col*scale,y+row*scale,scale,scale,c);
+    }
+}
+struct RailPalette { uint16_t background,foreground,accent,border,onAccent; };
+inline RailPalette railPalette(int style) {
+    if(style==1)return {0xF79C,0x198B,0xE4C4,0x9CF3,0x198B};
+    if(style==2)return {0x0841,0xF79C,0xE4C4,0x52AA,0x0841};
+    return {0x198B,0xF79C,0xE4C4,0x52EE,0x198B};
+}
+inline void hud(uint16_t *out,const Input &input,const char *title1,const char *title2,
+                bool cursorFallback=true,int style=0,const AudioState &audio=AudioState{}) {
+    const RailPalette p=railPalette(style);
+    rect(out,0,0,160,720,p.background);rect(out,1120,0,160,720,p.background);
+    text(out,title1,18,36,3,p.foreground);text(out,title2,18,66,2,p.accent);
+    text(out,input.hoverOnly?"MOVE ONLY":"TAP CLICK",20,104,2,p.foreground);
+    text(out,"TAB",1150,36,4,p.foreground);text(out,"CONTROLS",1140,78,2,p.accent);
+    for(const auto &button:buttons) {
+        bool active=(button.zone==Zone::Hover && input.hoverOnly)||(button.zone==Zone::Mute && audio.muted);
+        rect(out,button.x,button.y,button.w,button.h,active?p.accent:p.border);
+        rect(out,button.x+2,button.y+2,button.w-4,button.h-4,active?p.accent:p.background);
+        const char *label=button.zone==Zone::Mute && audio.muted ? "UNMUTE" : button.label;
+        int scale=button.zone==Zone::VolumeDown||button.zone==Zone::VolumeUp ? 5:3;
+        int n=0;while(label[n])++n;
+        text(out,label,button.x+(button.w-n*6*scale)/2+scale/2,button.y+(button.h-7*scale)/2,scale,active?p.onAccent:p.foreground);
+    }
+    text(out,"VOLUME",30,496,2,p.foreground);
+    text(out,audio.muted?"AUDIO OFF":"AUDIO ON",1138,657,2,p.foreground);
+    char volume[12];snprintf(volume,sizeof(volume),"VOL %d%%",audio.volume);
+    text(out,volume,1138,683,2,p.foreground);
+    if(!cursorFallback)return;
+    const auto &v=input.viewport;
+    int x=v.x+input.cursorX*v.w/v.gameW,y=v.y+input.cursorY*v.h/v.gameH;
+    for(int j=-10;j<=10;++j)for(int i=-10;i<=10;++i) {
+        if(x+i<v.x||x+i>=v.x+v.w||y+j<v.y||y+j>=v.y+v.h)continue;
+        if((i>=-2&&i<=2)||(j>=-2&&j<=2))pixel(out,x+i,y+j,0);
+        if(i==0||j==0)pixel(out,x+i,y+j,0xFFFF);
+    }
+}
+// The supported Sky/Queen engines provide CLUT8 cursors, including held items.
+// Render after scaling so the cached game surface never contains cursor trails.
+inline void cursor(uint16_t *out,const uint8_t *pixels,int w,int h,int pitch,
+                   int hotX,int hotY,int mouseX,int mouseY,uint8_t key,
+                   const uint16_t *palette,const Viewport &v=Viewport{}) {
+    for(int cy=0;cy<h;++cy)for(int cx=0;cx<w;++cx) {
+        uint8_t index=pixels[cy*pitch+cx]; if(index==key)continue;
+        int gx=mouseX-hotX+cx, gy=mouseY-hotY+cy;
+        if(gx<0||gx>=v.gameW||gy<0||gy>=v.gameH)continue;
+        int x=v.x+gx*v.w/v.gameW, y=v.y+gy*v.h/v.gameH;
+        rect(out,x,y,(gx+1)*v.w/v.gameW-gx*v.w/v.gameW,(gy+1)*v.h/v.gameH-gy*v.h/v.gameH,palette[index]);
+    }
+}
+}
