+        byte b=segments[d%10];
+        if(b&1)box(x+5,y,25,5,c);
+        if(b&2)box(x+30,y+5,5,24,c);
+        if(b&4)box(x+30,y+34,5,24,c);
+        if(b&8)box(x+5,y+58,25,5,c);
+        if(b&16)box(x,y+34,5,24,c);
+        if(b&32)box(x,y+5,5,24,c);
+        if(b&64)box(x+5,y+29,25,5,c);
