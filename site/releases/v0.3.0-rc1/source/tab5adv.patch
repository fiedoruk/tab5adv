+        _error->setLabel(p.storageProblem()?u(_pl?"Błąd profilu na microSD — sprawdź kartę.":"Profile error on microSD — check the card."):Common::U32String());
+    }
+    bool _pl=false,_motion=true,_libraryPage=false;unsigned _page=0;
+    Common::Array<ProfileArt::Entry> _entries;ProfileArt*_art;GraphicsWidget*_compass;
+    StaticTextWidget*_title,*_pages,*_error;
+    ButtonWidget*_overview,*_library,*_language,*_close,*_prev,*_next,*_animate,*_rules;
+};
