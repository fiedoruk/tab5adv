diff --git a/backends/platform/esp32/components/tab5_mad/mad.h b/backends/platform/esp32/components/tab5_mad/mad.h
new file mode 100644
index 00000000..65ba3459
--- /dev/null
+++ b/backends/platform/esp32/components/tab5_mad/mad.h
@@ -0,0 +1,980 @@
+/* libmad public header, generated with upstream mad.h.sed. See COPYRIGHT. */
+#ifdef __cplusplus
+extern "C" {
+#endif
+#define FPM_64BIT 1
+
+/* Id: version.h,v 1.26 2004/01/23 09:41:33 rob Exp */
+
+# ifndef LIBMAD_VERSION_H
+# define LIBMAD_VERSION_H
+
+# define MAD_VERSION_MAJOR	0
+# define MAD_VERSION_MINOR	15
+# define MAD_VERSION_PATCH	1
