+// Alternate complete snapshots: a short write must not destroy the last good one.
+static void load_profile() {
+    Tab5::Playtime::Snapshot snapshot;
+    bool found=false,valid=false;
+    for(unsigned slot=0;slot<2;++slot) {
+        char path[64];snprintf(path,sizeof(path),"/sdcard/scummvm/profile-%u.dat",slot);
+        FILE *f=fopen(path,"rb");if(!f)continue;
+        found=true;
+        const bool complete=fread(&snapshot,1,sizeof(snapshot),f)==sizeof(snapshot) && fgetc(f)==EOF;
+        fclose(f);
+        if(complete && Tab5::Playtime::valid(snapshot)) { valid=true;Tab5::playtime().restore(snapshot); }
+    }
+    Tab5::playtime().setStorageProblem(found && !valid);
+}
+static void save_profile() {
+    auto &profile=Tab5::playtime();if(!profile.dirty())return;
+    const auto snapshot=profile.snapshot();
+    char path[64];snprintf(path,sizeof(path),"/sdcard/scummvm/profile-%u.dat",unsigned(snapshot.sequence%2));
+    FILE *f=fopen(path,"wb");
+    if(!f) { profile.setStorageProblem(true);ESP_LOGW(TAG,"Could not write local playtime profile");return; }
+    bool ok=fwrite(&snapshot,1,sizeof(snapshot),f)==sizeof(snapshot);
+    if(fflush(f)!=0 || fsync(fileno(f))!=0)ok=false;
+    if(fclose(f)!=0)ok=false;
+    if(ok)profile.persisted(snapshot.sequence);
+    else ESP_LOGW(TAG,"Playtime write failed; previous snapshot retained");
+    profile.setStorageProblem(!ok);
+}
