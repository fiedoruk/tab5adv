+# libmad GPL-2.0-or-later; portable 64-bit fixed-point code for RISC-V.
+idf_component_register(SRCS version.c fixed.c bit.c timer.c stream.c frame.c
+  synth.c decoder.c layer12.c layer3.c huffman.c INCLUDE_DIRS ".")
+target_compile_definitions(${COMPONENT_LIB} PRIVATE HAVE_CONFIG_H FPM_64BIT)
+target_compile_options(${COMPONENT_LIB} PRIVATE -Wno-error -fwrapv)
