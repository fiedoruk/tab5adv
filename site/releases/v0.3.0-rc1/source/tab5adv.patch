diff --git a/gui/tab5-profile.h b/gui/tab5-profile.h
new file mode 100644
index 00000000..6abffe26
--- /dev/null
+++ b/gui/tab5-profile.h
@@ -0,0 +1,302 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#ifndef GUI_TAB5_PROFILE_H
+#define GUI_TAB5_PROFILE_H
+#include "common/tab5-playtime.h"
+#include "common/config-manager.h"
+#include "common/system.h"
+#include "common/stream.h"
+#include "gui/dialog.h"
+#include "gui/widget.h"
+#include "gui/gui-manager.h"
+#include "gui/about.h"
+#include "gui/message.h"
+#include "image/png.h"
+
+namespace GUI {
+class ProfileArt : public Widget {
+public:
+    struct Entry { Common::String target,title,engine,gameid; uint32 seconds,sessions; };
+    ProfileArt(GuiObject *boss):Widget(boss,36,112,1208,492,false){setFlags(WIDGET_ENABLED);}
+    ~ProfileArt() override {clearCovers();_canvas.free();}
+    void update(const Common::Array<Entry> &entries,bool pl,bool library,unsigned page) {
+        if(_library!=library||_page!=page)clearCovers();
+        _entries=entries;_pl=pl;_library=library;_page=page;markAsDirty();
+    }
+    void startMotion(){_step=0;_start=g_system->getMillis();setFlags(WIDGET_WANT_TICKLE);markAsDirty();}
+    void stopMotion(){_step=6;clearFlags(WIDGET_WANT_TICKLE);markAsDirty();}
+    void handleTickle() override {
+        unsigned step=MIN(6u,unsigned((g_system->getMillis()-_start)/90));
+        if(step!=_step){_step=step;markAsDirty();}
+        if(step==6)clearFlags(WIDGET_WANT_TICKLE);
+    }
+protected:
+    void drawWidget() override {
+        if(!_canvas.getPixels())_canvas.create(1208,492,g_gui.theme()->getPixelFormat());
+        _light=ConfMan.get("gui_theme",Common::ConfigManager::kApplicationDomain)=="tab5adv";
+        _canvas.fillRect(Common::Rect(0,0,1208,492),col(_light?247:11,_light?244:18,_light?235:32));
+        if(_library)drawLibrary();else drawOverview();
+        g_gui.theme()->drawManagedSurface(Common::Point(_x,_y),_canvas,Graphics::ALPHA_OPAQUE);
+    }
+private:
+    uint32 col(byte r,byte g,byte b) const{return _canvas.format.RGBToColor(r,g,b);}
+    uint32 ink() const{return _light?col(37,45,55):col(238,236,226);}
+    uint32 muted() const{return _light?col(83,94,104):col(165,181,190);}
+    uint32 panel() const{return _light?col(255,253,247):col(25,36,52);}
+    uint32 edge() const{return _light?col(214,207,192):col(58,75,89);}
+    uint32 accent(unsigned i) const {
+        static const byte rgb[5][3]={{230,170,75},{85,197,173},{237,146,122},{169,152,235},{124,181,224}};
+        const byte *p=rgb[i%5];return col(p[0],p[1],p[2]);
+    }
+    void box(int x,int y,int w,int h,uint32 c){_canvas.fillRect(Common::Rect(x,y,x+w,y+h),c);}
+    void round(int x,int y,int w,int h,int,uint32 c){box(x,y,w,h,c);}
+    void card(int x,int y,int w,int h){box(x,y,w,h,panel());_canvas.frameRect(Common::Rect(x,y,x+w,y+h),edge());}
+    static Common::U32String u(const char*s){return Common::U32String(s,Common::kUtf8);}
+    void txt(int x,int y,int w,const Common::String&s,bool bold=false,uint32 c=0){
+        g_gui.getFont(bold?ThemeEngine::kFontStyleBold:ThemeEngine::kFontStyleNormal)
+            .drawString(_canvas.surfacePtr(),u(s.c_str()),x,y,w,c?c:ink(),Graphics::kTextAlignLeft,0,true);
+    }
+    void titleTwoLines(int x,int y,int w,const Common::String &title){
+        const Graphics::Font &font=g_gui.getFont(ThemeEngine::kFontStyleBold);
+        Common::U32String full=u(title.c_str());
+        if(font.getStringWidth(full)<=w){font.drawString(_canvas.surfacePtr(),full,x,y,w,ink());return;}
+        unsigned cut=1,word=0;
+        while(cut<full.size() && font.getStringWidth(full.substr(0,cut+1))<=w){
+            if(full[cut]==' ')word=cut;
+            ++cut;
+        }
+        if(word)cut=word;
+        font.drawString(_canvas.surfacePtr(),full.substr(0,cut),x,y,w,ink());
+        font.drawString(_canvas.surfacePtr(),full.substr(cut+(word?1:0)),x,y+31,w,ink(),Graphics::kTextAlignLeft,0,true);
+    }
+    Common::String duration(uint64 s) const{
+        if(!s)return "0 min";
+        if(s<60)return "<1 min";
+        if(s<3600)return Common::String::format("%u min",unsigned(s/60));
+        return Common::String::format("%llu h %02u min",(unsigned long long)(s/3600),unsigned(s/60%60));
+    }
+    void line(int x,int y,int xx,int yy,uint32 c){_canvas.drawLine(x,y,xx,yy,c);_canvas.drawLine(x+1,y,xx+1,yy,c);}
+    void compass(int x,int y,int r,uint32 c){
+        static const int dx[8]={0,7,10,7,0,-7,-10,-7},dy[8]={-10,-7,0,7,10,7,0,-7};
+        for(unsigned i=0;i<MIN(8u,1u+_step*8u/6u);++i){unsigned j=(i+1)%8;line(x+dx[i]*r/10,y+dy[i]*r/10,x+dx[j]*r/10,y+dy[j]*r/10,c);}
+        if(_step==6){line(x,y-r+5,x,y+r-5,c);line(x-r+5,y,x+r-5,y,c);line(x,y-r+5,x+5,y+4,c);line(x+5,y+4,x,y,c);}
+    }
+    void star(int x,int y,int r,uint32 c){
+        static const int dx[5]={0,9,6,-6,-9},dy[5]={-10,-3,8,8,-3};
+        for(int i=0;i<5;++i){int j=(i+2)%5;line(x+dx[i]*r/10,y+dy[i]*r/10,x+dx[j]*r/10,y+dy[j]*r/10,c);}
+    }
+    void flag(int x,int y,uint32 c){
+        line(x,y,x,y+34,c);line(x+1,y+1,x+22,y+4,c);line(x+22,y+4,x+13,y+14,c);line(x+13,y+14,x+1,y+11,c);
+    }
+    void digit(int x,int y,unsigned d,uint32 c){
