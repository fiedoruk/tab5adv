+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include "gui/gui-manager.h"
+#include "gui/ThemeEval.h"
+#include "gui/widget.h"
+#include "gui/widgets/popup.h"
+#include "common/config-manager.h"
+
+class Tab5OptionsWidget : public GUI::OptionsContainerWidget {
+public:
+    Tab5OptionsWidget(GUI::GuiObject *boss,const Common::String &name,const Common::String &domain)
+        : OptionsContainerWidget(boss,name,"Tab5OptionsDialog",domain) {
+        _label=new GUI::StaticTextWidget(widgetsBoss(),"Tab5OptionsDialog.Label",Common::U32String("Sidebars:"));
+        _style=new GUI::PopUpWidget(widgetsBoss(),"Tab5OptionsDialog.Style");
+        _style->appendEntry(Common::U32String("Dark blue"),0);
+        _style->appendEntry(Common::U32String("Light"),1);
+        _style->appendEntry(Common::U32String("Black"),2);
+        _style->appendEntry(Common::U32String("Follow menu skin"),3);
+        _hint=new GUI::StaticTextWidget(widgetsBoss(),"Tab5OptionsDialog.Hint",Common::U32String("GUI > Theme"));
+    }
+    void load() override { _style->setSelectedTag(ConfMan.getInt("tab5_rail_style",_domain)); }
+    bool save() override {
+        if(!_enabled)return false;
+        int style=_style->getSelectedTag();
+        bool changed=style!=ConfMan.getInt("tab5_rail_style",_domain);
+        ConfMan.setInt("tab5_rail_style",style,_domain);return changed;
+    }
+    bool hasKeys() override { return ConfMan.hasKey("tab5_rail_style",_domain); }
+    void setEnabled(bool enabled) override { _enabled=enabled;_label->setEnabled(enabled);_style->setEnabled(enabled);_hint->setEnabled(enabled); }
+private:
+    void defineLayout(GUI::ThemeEval &layouts,const Common::String &name,const Common::String &overlay) const override {
+        layouts.addDialog(name,overlay)
+            .addLayout(GUI::ThemeLayout::kLayoutVertical).addPadding(0,0,4,4)
+                .addLayout(GUI::ThemeLayout::kLayoutHorizontal)
+                    .addWidget("Label","OptionsLabel").addWidget("Style","PopUp")
+                .closeLayout()
+                .addWidget("Hint","OptionsLabel")
+            .closeLayout().closeDialog();
+    }
+    GUI::StaticTextWidget *_label,*_hint;
+    GUI::PopUpWidget *_style;
+    bool _enabled=true;
+};
diff --git a/backends/platform/esp32/main/tab5-pixels.h b/backends/platform/esp32/main/tab5-pixels.h
new file mode 100644
index 00000000..a7efbf60
--- /dev/null
+++ b/backends/platform/esp32/main/tab5-pixels.h
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <stdint.h>
+#include <string.h>
+
+namespace Tab5 {
+// P4 and the tested host are little-endian. Packed rows may be unaligned.
+struct PixelLayout { uint8_t bytes,rLoss,gLoss,bLoss,rShift,gShift,bShift; };
+inline void copyRGB565(const uint8_t *source,int pitch,uint16_t *out,int outWidth,
+                      int left,int top,int right,int bottom,PixelLayout f,
+                      const uint16_t *palette) {
+    for(int y=top;y<bottom;++y) {
+        const uint8_t *src=source+y*pitch+left*f.bytes;
+        uint16_t *dst=out+y*outWidth+left;
+        if(f.bytes==1) {
+            for(int x=left;x<right;++x)*dst++=palette[*src++];
+            continue;
+        }
+        if(f.bytes==2 && f.rLoss==3 && f.gLoss==2 && f.bLoss==3 &&
+           f.rShift==11 && f.gShift==5 && f.bShift==0) {
+            memcpy(dst,src,(right-left)*sizeof(uint16_t));
+            continue;
+        }
+        if(f.bytes==4 && f.rLoss==0 && f.gLoss==0 && f.bLoss==0 &&
+           f.rShift==24 && f.gShift==16 && f.bShift==8) {
+            // SLUDGE's little-endian RGBA: avoid one variable-size memcpy
+            // call and variable shifts for each of the 307,200 pixels.
+            for(int x=left;x<right;++x,src+=4)
+                *dst++=((src[3]>>3)<<11)|((src[2]>>2)<<5)|(src[1]>>3);
+            continue;
+        }
+        for(int x=left;x<right;++x,src+=f.bytes) {
+            uint32_t pixel=0;
+            memcpy(&pixel,src,f.bytes);
+            const uint8_t r=((pixel>>f.rShift)&(255>>f.rLoss))<<f.rLoss;
+            const uint8_t g=((pixel>>f.gShift)&(255>>f.gLoss))<<f.gLoss;
+            const uint8_t b=((pixel>>f.bShift)&(255>>f.bLoss))<<f.bLoss;
+            *dst++=((r>>3)<<11)|((g>>2)<<5)|(b>>3);
+        }
+    }
+}
+}
