+void OSystem_esp32::syncMasterAudio(bool force) {
+    if(!_mixerManager || !_graphicsManager)return;
+    Tab5::AudioState next;
+    next.volume=CLIP(ConfMan.getInt("tab5_master_volume",Common::ConfigManager::kApplicationDomain),0,100);
+    next.muted=ConfMan.getBool("mute",Common::ConfigManager::kApplicationDomain);
+    if(force || next.volume!=_masterAudio.volume || next.muted!=_masterAudio.muted) {
+        _masterAudio=next;
+        static_cast<EspMixerManager *>(_mixerManager)->setOutput(next.volume,next.muted);
+        static_cast<EspGraphicsManager *>(_graphicsManager)->setAudioState(next);
+        ESP_LOGI(TAG,"TAB5ADV_AUDIO volume=%d muted=%d",next.volume,next.muted);
+    }
+}
+void OSystem_esp32::adjustMasterAudio(Tab5::Action action) {
+    Tab5::AudioState next=_masterAudio;
+    if(action==Tab5::Action::Mute)next.toggleMute();
+    else next.changeVolume(action==Tab5::Action::VolumeUp?10:-10);
+    if(next.volume==_masterAudio.volume && next.muted==_masterAudio.muted)return;
+    ConfMan.setInt("tab5_master_volume",next.volume,Common::ConfigManager::kApplicationDomain);
+    ConfMan.setBool("mute",next.muted,Common::ConfigManager::kApplicationDomain);
+    ConfMan.flushToDisk();
+    if(g_engine)g_engine->syncSoundSettings();
+    syncMasterAudio(true);
+}
