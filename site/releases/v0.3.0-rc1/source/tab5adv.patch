diff --git a/common/tab5-playtime.h b/common/tab5-playtime.h
new file mode 100644
index 00000000..30cd8548
--- /dev/null
+++ b/common/tab5-playtime.h
@@ -0,0 +1,98 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#ifndef COMMON_TAB5_PLAYTIME_H
+#define COMMON_TAB5_PLAYTIME_H
+
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+
+namespace Tab5 {
+// One local device profile. No wall clock, identity, network or game-save edits.
+class Playtime {
+public:
+    enum { kCapacity=64, kIdleMs=300000 };
+    struct Record { char target[64]; uint32_t seconds, sessions; };
+    struct Snapshot { uint32_t magic,version,sequence,count; Record records[kCapacity]; uint32_t checksum; };
+    Playtime() { memset(&_data,0,sizeof(_data)); _data.magic=0x35414456; _data.version=1; }
+    static uint32_t checksum(const Snapshot &s) {
+        const unsigned char *p=reinterpret_cast<const unsigned char *>(&s);
+        uint32_t h=2166136261u;
+        for(size_t i=0;i<offsetof(Snapshot,checksum);++i)h=(h^p[i])*16777619u;
+        return h;
+    }
+    static bool validId(const char *id) {
+        if(!id || !*id)return false;
+        for(unsigned i=0;i<64;++i) {
+            const unsigned char c=id[i]; if(!c)return true;
+            if(!((c>='a'&&c<='z')||(c>='A'&&c<='Z')||(c>='0'&&c<='9')||c=='-'||c=='_'||c=='.'))return false;
+        }
+        return false;
+    }
+    static bool valid(const Snapshot &s) {
+        if(s.magic!=0x35414456 || s.version!=1 || s.count>kCapacity || checksum(s)!=s.checksum)return false;
+        for(unsigned i=0;i<s.count;++i) {
+            if(!validId(s.records[i].target))return false;
+            for(unsigned j=0;j<i;++j)if(!strcmp(s.records[i].target,s.records[j].target))return false;
+        }
+        return true;
+    }
+    bool restore(const Snapshot &s) {
+        if(!valid(s) || (_loaded && int32_t(s.sequence-_data.sequence)<=0))return false;
+        _data=s; _loaded=true; _dirty=false; return true;
+    }
+    Snapshot snapshot() const { Snapshot s=_data; ++s.sequence; s.checksum=checksum(s); return s; }
+    void persisted(uint32_t sequence) { _data.sequence=sequence; _dirty=false; }
+    bool dirty() const { return _dirty; }
+    bool storageProblem() const { return _storageProblem; }
+    void setStorageProblem(bool value) { _storageProblem=value; }
+    const Record *find(const char *id) const {
+        for(unsigned i=0;i<_data.count;++i)if(!strcmp(id,_data.records[i].target))return &_data.records[i];
+        return nullptr;
+    }
+    uint64_t totalSeconds() const { uint64_t n=0; for(unsigned i=0;i<_data.count;++i)n+=_data.records[i].seconds; return n; }
+    unsigned explored() const { unsigned n=0; for(unsigned i=0;i<_data.count;++i)n+=_data.records[i].seconds>=60; return n; }
+    unsigned points() const { return explored()*10; }
+    void start(const char *target,uint64_t now) {
+        _active=-1; _lastTick=now; _lastInput=now; _remainder=0; _touched=false; _wasEligible=false;
+        if(!validId(target))return;
+        for(unsigned i=0;i<_data.count;++i)if(!strcmp(target,_data.records[i].target))_active=i;
+        if(_active<0 && _data.count<kCapacity) {
+            _active=_data.count++; memcpy(_data.records[_active].target,target,strlen(target)+1); _dirty=true;
+        }
+    }
+    void activity(uint64_t now) {
+        if(_active<0)return;
+        if(!_touched) {
+            if(_data.records[_active].sessions<UINT32_MAX)++_data.records[_active].sessions;
+            _dirty=true; _touched=true;
+        }
+        _lastInput=now;
+    }
+    void tick(uint64_t now,bool eligible) {
+        if(now<_lastTick) { _lastTick=now; _wasEligible=false; return; }
+        const uint64_t until=now<_lastInput+kIdleMs ? now : _lastInput+kIdleMs;
+        // Long blocked loads or USB diagnostic snapshots are not play time.
+        if(_active>=0 && _touched && eligible && _wasEligible && now-_lastTick<=2000 && until>_lastTick) {
+            _remainder+=unsigned(until-_lastTick);
+            uint32_t seconds=_remainder/1000; _remainder%=1000;
+            if(seconds) {
+                Record &r=_data.records[_active];
+                r.seconds+=seconds>UINT32_MAX-r.seconds ? UINT32_MAX-r.seconds : seconds;
+                _dirty=true;
+            }
+        }
+        _lastTick=now; _wasEligible=eligible;
+    }
+    void stop(uint64_t now) { tick(now,_wasEligible); _active=-1; _wasEligible=false; }
+private:
+    Snapshot _data;
+    int _active=-1;
+    uint64_t _lastTick=0,_lastInput=0;
+    unsigned _remainder=0;
+    bool _loaded=false,_dirty=false,_touched=false,_wasEligible=false;
+    bool _storageProblem=false;
+};
+static_assert(sizeof(Playtime::Snapshot)==4628,"Profile snapshot format changed");
+inline Playtime &playtime() { static Playtime value; return value; }
+}
+#endif
