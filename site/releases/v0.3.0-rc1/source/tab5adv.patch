diff --git a/backends/platform/esp32/main/installer.c b/backends/platform/esp32/main/installer.c
new file mode 100644
index 00000000..4ae5a456
--- /dev/null
+++ b/backends/platform/esp32/main/installer.c
@@ -0,0 +1,321 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "installer.h"
+
+#include <ctype.h>
+#include <dirent.h>
+#include <errno.h>
+#include <stdarg.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "driver/usb_serial_jtag.h"
+#include "driver/usb_serial_jtag_vfs.h"
+#include "esp_err.h"
+#include "esp_log.h"
+#include "esp_system.h"
+#include "esp_timer.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+#include "mbedtls/sha256.h"
+
+#define INSTALLER_LINE_MAX 384
+#define INSTALLER_CHUNK 4096
+#define INSTALLER_WINDOW_MS 5000
+#define INSTALLER_MAX_FILE (512ULL * 1024ULL * 1024ULL)
+
+static const char *TAG = "Tab5Installer";
+
+static void send_line(const char *fmt, ...)
+{
+    char line[INSTALLER_LINE_MAX];
+    va_list args;
+    va_start(args, fmt);
+    int len = vsnprintf(line, sizeof(line), fmt, args);
+    va_end(args);
+    if (len < 0) return;
+    if ((size_t)len >= sizeof(line) - 1) len = sizeof(line) - 2;
+    line[len++] = '\n';
+    usb_serial_jtag_write_bytes(line, len, pdMS_TO_TICKS(1000));
+    usb_serial_jtag_wait_tx_done(pdMS_TO_TICKS(1000));
+}
+
+static int read_line(char *line, size_t capacity, uint32_t timeout_ms)
+{
+    size_t used = 0;
+    int64_t deadline = esp_timer_get_time() + (int64_t)timeout_ms * 1000;
+    while (esp_timer_get_time() < deadline && used + 1 < capacity) {
+        char byte;
+        int got = usb_serial_jtag_read_bytes(&byte, 1, pdMS_TO_TICKS(50));
+        if (got <= 0) continue;
+        if (byte == '\r') continue;
+        if (byte == '\n') {
+            line[used] = 0;
+            return (int)used;
+        }
+        line[used++] = byte;
+    }
+    line[used] = 0;
+    return -1;
+}
+
+static bool safe_path(const char *path)
+{
+    if (!path || !*path || path[0] == '/' || strlen(path) > 220) return false;
+    if (strncmp(path, "scummvm/", 8) != 0 && strncmp(path, "games/", 6) != 0) return false;
+    const char *segment = path;
+    for (const char *p = path; ; ++p) {
+        unsigned char c = (unsigned char)*p;
+        if (c == '/' || c == 0) {
+            size_t length = (size_t)(p - segment);
+            if (length == 0 || (length == 1 && segment[0] == '.') ||
+                (length == 2 && segment[0] == '.' && segment[1] == '.')) return false;
+            if (c == 0) break;
+            segment = p + 1;
+        } else if (!(isalnum(c) || c == '.' || c == '_' || c == '-')) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool make_parents(const char *full_path)
+{
+    char work[256];
+    if (strlen(full_path) >= sizeof(work)) return false;
+    strcpy(work, full_path);
+    for (char *p = work + strlen("/sdcard/"); *p; ++p) {
+        if (*p != '/') continue;
+        *p = 0;
+        if (mkdir(work, 0755) != 0 && errno != EEXIST) return false;
+        *p = '/';
+    }
+    return true;
+}
+
+static void sha_to_hex(const unsigned char digest[32], char out[65])
+{
+    static const char hex[] = "0123456789abcdef";
+    for (int i = 0; i < 32; ++i) {
+        out[i * 2] = hex[digest[i] >> 4];
+        out[i * 2 + 1] = hex[digest[i] & 0x0f];
+    }
+    out[64] = 0;
+}
+
+static bool receive_file(const char *relative, uint64_t size, const char *expected_hex, bool replace)
+{
+    if (!safe_path(relative) || size > INSTALLER_MAX_FILE || strlen(expected_hex) != 64) {
+        send_line("T5A1 ERROR invalid-put");
+        return false;
+    }
+    for (const char *p = expected_hex; *p; ++p) {
+        if (!isxdigit((unsigned char)*p)) {
+            send_line("T5A1 ERROR invalid-sha");
+            return false;
+        }
+    }
+
+    char target[256];
+    char staging[272];
+    snprintf(target, sizeof(target), "/sdcard/%s", relative);
+    snprintf(staging, sizeof(staging), "%s.tab5adv-part", target);
+    if (!make_parents(target)) {
+        send_line("T5A1 ERROR mkdir");
+        return false;
+    }
+    struct stat st;
+    if (!replace && stat(target, &st) == 0) {
+        send_line("T5A1 ERROR exists");
+        return false;
+    }
+    unlink(staging);
+    FILE *output = fopen(staging, "wb");
+    if (!output) {
+        send_line("T5A1 ERROR open");
+        return false;
+    }
+
+    unsigned char *buffer = malloc(INSTALLER_CHUNK);
+    if (!buffer) {
+        fclose(output);
+        unlink(staging);
+        send_line("T5A1 ERROR memory");
+        return false;
+    }
+    mbedtls_sha256_context sha;
+    mbedtls_sha256_init(&sha);
+    mbedtls_sha256_starts(&sha, 0);
+    uint64_t received = 0;
+    bool ok = true;
+    send_line("T5A1 GO %llu", (unsigned long long)size);
+    while (received < size) {
+        size_t wanted = (size - received > INSTALLER_CHUNK) ? INSTALLER_CHUNK : (size_t)(size - received);
+        send_line("T5A1 CHUNK %u %llu", (unsigned)wanted, (unsigned long long)received);
+        size_t have = 0;
+        int idle = 0;
+        while (have < wanted && idle < 100) {
+            int got = usb_serial_jtag_read_bytes(buffer + have, wanted - have, pdMS_TO_TICKS(100));
+            if (got > 0) {
+                have += (size_t)got;
+                idle = 0;
+            } else {
+                ++idle;
+            }
+        }
+        if (have != wanted || fwrite(buffer, 1, wanted, output) != wanted) {
+            ok = false;
+            break;
+        }
+        mbedtls_sha256_update(&sha, buffer, wanted);
+        received += wanted;
+        send_line("T5A1 ACK %llu", (unsigned long long)received);
+    }
+
+    unsigned char digest[32];
+    mbedtls_sha256_finish(&sha, digest);
+    mbedtls_sha256_free(&sha);
+    free(buffer);
+    if (fflush(output) != 0 || fsync(fileno(output)) != 0) ok = false;
+    if (fclose(output) != 0) ok = false;
+
+    char actual_hex[65];
+    sha_to_hex(digest, actual_hex);
+    if (!ok || strcasecmp(actual_hex, expected_hex) != 0) {
+        unlink(staging);
+        send_line("T5A1 ERROR verify %s", actual_hex);
+        return false;
+    }
+    if (replace) unlink(target);
+    if (rename(staging, target) != 0) {
+        unlink(staging);
+        send_line("T5A1 ERROR publish");
+        return false;
+    }
+    send_line("T5A1 STORED %s %llu %s", relative, (unsigned long long)size, actual_hex);
+    return true;
+}
+
+// Reversible maintenance/QC: move a whole game directory, never saves/config
+// or another card namespace. Never replace an existing destination.
+static void move_game_directory(const char *source,const char *destination) {
+    if(!safe_path(source)||!safe_path(destination)||strncmp(source,"games/",6)||strncmp(destination,"games/",6)
+       ||strchr(source+6,'/')||strchr(destination+6,'/')) { send_line("T5A1 ERROR invalid-move");return; }
+    char from[256],to[256];struct stat st;
+    snprintf(from,sizeof(from),"/sdcard/%s",source);snprintf(to,sizeof(to),"/sdcard/%s",destination);
+    if(stat(from,&st)!=0||!S_ISDIR(st.st_mode)) { send_line("T5A1 ERROR missing-directory");return; }
+    if(stat(to,&st)==0) { send_line("T5A1 ERROR destination-exists");return; }
+    if(rename(from,to)!=0) { send_line("T5A1 ERROR move");return; }
+    send_line("T5A1 MOVED %s %s",source,destination);
+}
+
+static void hash_file(const char *relative)
+{
+    if (!safe_path(relative)) { send_line("T5A1 ERROR invalid-path"); return; }
+    char path[256]; snprintf(path,sizeof(path),"/sdcard/%s",relative);
+    FILE *file=fopen(path,"rb");
+    if(!file) { send_line("T5A1 ERROR missing-file"); return; }
+    unsigned char *buffer=malloc(INSTALLER_CHUNK);
+    if(!buffer) { fclose(file);send_line("T5A1 ERROR memory");return; }
+    mbedtls_sha256_context sha;mbedtls_sha256_init(&sha);mbedtls_sha256_starts(&sha,0);
+    size_t n;
+    while((n=fread(buffer,1,INSTALLER_CHUNK,file))>0)mbedtls_sha256_update(&sha,buffer,n);
+    bool ok=!ferror(file); fclose(file);free(buffer);
+    unsigned char digest[32];char hex[65];
+    mbedtls_sha256_finish(&sha,digest);mbedtls_sha256_free(&sha);sha_to_hex(digest,hex);
+    if(ok)send_line("T5A1 HASH %s %s",relative,hex);
+    else send_line("T5A1 ERROR read");
+}
+
+static void list_dir(const char *full, const char *relative, int depth)
+{
+    DIR *dir = opendir(full);
+    if (!dir) return;
+    const bool game_root = !strncmp(relative, "games/", 6) && relative[6] && !strchr(relative + 6, '/');
+    struct dirent *entry;
+    while ((entry = readdir(dir)) != NULL) {
+        if (!strcmp(entry->d_name, ".") || !strcmp(entry->d_name, "..")) continue;
+        char child_full[320];
+        char child_rel[280];
+        snprintf(child_full, sizeof(child_full), "%s/%s", full, entry->d_name);
+        snprintf(child_rel, sizeof(child_rel), "%s%s%s", relative, *relative ? "/" : "", entry->d_name);
+        struct stat st;
+        if (stat(child_full, &st) != 0) continue;
+        send_line("T5A1 ITEM %c %llu %s", S_ISDIR(st.st_mode) ? 'D' : 'F',
+                  (unsigned long long)st.st_size, child_rel);
+        // Include one nested asset folder per game and the existing save folders.
+        // Other SD paths keep the original depth limit.
+        if (S_ISDIR(st.st_mode) && (depth > 0 || game_root || !strcmp(relative,"scummvm/saves")))
+            list_dir(child_full, child_rel, depth > 0 ? depth - 1 : 0);
+    }
+    closedir(dir);
+}
+
+bool tab5adv_installer_wait(void)
+{
+    usb_serial_jtag_driver_config_t config = {
+        .tx_buffer_size = 8192,
+        .rx_buffer_size = 8192,
+    };
+    if (!usb_serial_jtag_is_driver_installed()) {
+        esp_err_t err = usb_serial_jtag_driver_install(&config);
+        if (err != ESP_OK) {
+            ESP_LOGW(TAG, "USB installer unavailable: %s", esp_err_to_name(err));
+            return false;
+        }
+        usb_serial_jtag_vfs_use_driver();
+    }
+    send_line("T5A1 WAIT %u", INSTALLER_WINDOW_MS);
+    char line[INSTALLER_LINE_MAX];
+    if (read_line(line, sizeof(line), INSTALLER_WINDOW_MS) < 0 || strcmp(line, "T5A1") != 0) {
+        send_line("T5A1 BOOT");
+        usb_serial_jtag_wait_tx_done(pdMS_TO_TICKS(250));
+        usb_serial_jtag_vfs_use_nonblocking();
+        usb_serial_jtag_driver_uninstall();
+        return false;
+    }
+    ESP_LOGI(TAG, "installer mode active");
+    send_line("T5A1 READY");
+    while (true) {
+        if (read_line(line, sizeof(line), 60000) < 0) {
+            send_line("T5A1 ERROR timeout");
+            continue;
+        }
+        if (!strcmp(line, "PING")) {
+            send_line("T5A1 PONG");
+        } else if (!strcmp(line, "INFO")) {
+            send_line("T5A1 INFO 7");
+        } else if (!strncmp(line, "HASH ", 5)) {
+            hash_file(line+5);
+        } else if (!strncmp(line, "MOVE ",5)) {
+            char from[224],to[224];
+            if(sscanf(line+5,"%223s %223s",from,to)!=2)send_line("T5A1 ERROR invalid-command");
+            else move_game_directory(from,to);
+        } else if (!strcmp(line, "LIST")) {
+            list_dir("/sdcard", "", 2);
+            send_line("T5A1 LIST-DONE");
+        } else if (!strcmp(line, "DONE")) {
+            send_line("T5A1 RESTART");
+            vTaskDelay(pdMS_TO_TICKS(250));
+            esp_restart();
+        } else if (!strncmp(line, "PUT ", 4)) {
+            char relative[224];
+            char expected[65];
+            unsigned long long size = 0;
+            unsigned replace = 0;
+            if (sscanf(line + 4, "%223s %llu %64s %u", relative, &size, expected, &replace) != 4) {
+                send_line("T5A1 ERROR invalid-command");
+            } else {
+                receive_file(relative, (uint64_t)size, expected, replace != 0);
+            }
+        } else {
+            send_line("T5A1 ERROR unknown-command");
+        }
+    }
+}
