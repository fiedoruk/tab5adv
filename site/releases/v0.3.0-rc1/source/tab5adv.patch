+		esp_lcd_panel_disp_on_off(panel, true);
+		bsp_display_brightness_init();
+		bsp_display_brightness_set(100);
+		uint16_t *frame = NULL;
+		if (esp_lcd_dpi_panel_get_frame_buffer(panel, 1, (void **)&frame) == ESP_OK) {
+			const uint16_t navy = (3 << 11) | (12 << 5) | 18;
+			const uint16_t amber = (28 << 11) | (38 << 5) | 4;
+			for (int i = 0; i < BSP_LCD_H_RES * BSP_LCD_V_RES; ++i) frame[i] = navy;
+			error_text(frame, "NO SD CARD", 280, 210, 12, 0xFFFF);
+			error_text(frame, "INSERT FAT32 CARD", 376, 380, 6, amber);
+			error_text(frame, "RESTART TAB5", 424, 500, 6, 0xFFFF);
+			esp_lcd_panel_draw_bitmap(panel, 0, 0, BSP_LCD_H_RES, BSP_LCD_V_RES, frame);
+		}
+	}
+	while (true) vTaskDelay(pdMS_TO_TICKS(1000));
+}
