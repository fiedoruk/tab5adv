+        _canvas.blitFrom(*large,Common::Point(30,70));large->free();delete large;small.free();
+    }
+    struct Cover { Common::String key;Graphics::ManagedSurface *image; };
+    void clearCovers(){for(auto &c:_covers)delete c.image;_covers.clear();}
+    bool cover(int x,int y,int w,int h,const Entry&e){
+#ifdef USE_PNG
+        Common::String key=e.engine+"-"+e.gameid;
+        for(const auto &cached:_covers)if(cached.key==key){
+            if(cached.image)_canvas.blitFrom(cached.image->rawSurface(),Common::Point(x+(w-cached.image->w)/2,y+(h-cached.image->h)/2));
+            return cached.image!=nullptr;
+        }
+        const Common::String paths[2]={Common::String::format("icons/%s-%s.png",e.engine.c_str(),e.gameid.c_str()),Common::String::format("icons/%s.png",e.engine.c_str())};
+        for(const auto &name:paths){
+            g_gui.lockIconsSet();
+            Common::SeekableReadStream *stream=g_gui.getIconsSet().createReadStreamForMember(Common::Path(name));
+            if(!stream){g_gui.unlockIconsSet();continue;}
+            Image::PNGDecoder decoder;bool ok=decoder.loadStream(*stream);delete stream;
+            const Graphics::Surface *src=ok?decoder.getSurface():nullptr;
+            if(src && src->format.bytesPerPixel>1){
+                int iw=w,ih=int((int64(src->h)*w)/src->w);
+                if(ih>h){ih=h;iw=int((int64(src->w)*h)/src->h);}
