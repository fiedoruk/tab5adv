+static void register_managed_games() {
+    bool changed=false;
+    for (const auto &game:Tab5::games) {
+        char path[240]; struct stat st;
+        snprintf(path,sizeof(path),"/sdcard/games/%s/game.json",game.id);
+        bool complete=stat(path,&st)==0 && S_ISREG(st.st_mode) && st.st_size>0;
+        for (const Tab5::RequiredFile *file=game.files;complete && file->name;++file) {
+            snprintf(path,sizeof(path),"/sdcard/games/%s/%s",game.id,file->name);
+            complete=stat(path,&st)==0 && S_ISREG(st.st_mode) && st.st_size==file->size;
+        }
+        if(!complete)continue;
+        const bool existing=ConfMan.hasGameDomain(game.target);
+        // SLUDGE scripts choose generic filenames (e.g. quicksave.sav).
+        // Keep each game's files separate, while preserving explicit user paths.
+        if(!strcmp(game.engine,"sludge") && !ConfMan.hasKey("savepath",game.target)) {
+            Common::String saveBase=ConfMan.get("savepath",Common::ConfigManager::kApplicationDomain);
+            if(saveBase.empty())saveBase="/sdcard/scummvm/saves";
+            mkdir(saveBase.c_str(),0755);
+            const Common::String saveDir=saveBase+"/"+game.id;
+            if(mkdir(saveDir.c_str(),0755)!=0 && errno!=EEXIST)
+                ESP_LOGW(TAG,"Could not create game save directory: %s",saveDir.c_str());
+            if(!ConfMan.hasGameDomain(game.target))ConfMan.addGameDomain(game.target);
+            ConfMan.set("savepath",saveDir,game.target);
+            changed=true;
+        }
+        if(existing)continue;
+        if(!ConfMan.hasGameDomain(game.target))ConfMan.addGameDomain(game.target);
+        ConfMan.set("description",game.title,game.target);
+        ConfMan.set("engineid",game.engine,game.target);
+        ConfMan.set("gameid",game.target,game.target);
+        ConfMan.set("language",game.language,game.target);
+        ConfMan.set("platform",game.platform,game.target);
+        snprintf(path,sizeof(path),"/sdcard/games/%s/",game.id);
+        ConfMan.set("path",path,game.target);
+        changed=true;
+        ESP_LOGI(TAG,"TAB5ADV_REGISTER target=%s engine=%s",game.target,game.engine);
+    }
+    // Append only complete new games; retain every existing preference/save path.
+    if(changed)ConfMan.flushToDisk();
+}
