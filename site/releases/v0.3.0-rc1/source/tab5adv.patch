+static const uint8_t *error_glyph(char value) {
+	static const uint8_t a[7]={0x0E,0x11,0x11,0x1F,0x11,0x11,0x11};
+	static const uint8_t b[7]={0x1E,0x11,0x11,0x1E,0x11,0x11,0x1E};
+	static const uint8_t c[7]={0x0E,0x11,0x10,0x10,0x10,0x11,0x0E};
+	static const uint8_t d[7]={0x1E,0x11,0x11,0x11,0x11,0x11,0x1E};
+	static const uint8_t e[7]={0x1F,0x10,0x10,0x1E,0x10,0x10,0x1F};
+	static const uint8_t f[7]={0x1F,0x10,0x10,0x1E,0x10,0x10,0x10};
+	static const uint8_t i[7]={0x1F,0x04,0x04,0x04,0x04,0x04,0x1F};
+	static const uint8_t n[7]={0x11,0x19,0x19,0x15,0x13,0x13,0x11};
+	static const uint8_t o[7]={0x0E,0x11,0x11,0x11,0x11,0x11,0x0E};
+	static const uint8_t r[7]={0x1E,0x11,0x11,0x1E,0x14,0x12,0x11};
+	static const uint8_t s[7]={0x0F,0x10,0x10,0x0E,0x01,0x01,0x1E};
+	static const uint8_t t[7]={0x1F,0x04,0x04,0x04,0x04,0x04,0x04};
+	static const uint8_t two[7]={0x0E,0x11,0x01,0x02,0x04,0x08,0x1F};
+	static const uint8_t three[7]={0x1E,0x01,0x01,0x0E,0x01,0x01,0x1E};
+	static const uint8_t five[7]={0x1F,0x10,0x10,0x1E,0x01,0x01,0x1E};
+	switch (value) {
+	case 'A': return a; case 'B': return b; case 'C': return c; case 'D': return d;
+	case 'E': return e; case 'F': return f; case 'I': return i; case 'N': return n;
+	case 'O': return o; case 'R': return r; case 'S': return s; case 'T': return t;
+	case '2': return two; case '3': return three; case '5': return five;
+	default: return NULL;
+	}
+}
+
+static void error_pixel(uint16_t *frame, int logical_x, int logical_y, uint16_t color) {
+	if (logical_x < 0 || logical_x >= BSP_LCD_V_RES || logical_y < 0 || logical_y >= BSP_LCD_H_RES) return;
+	int panel_x = logical_y;
+	int panel_y = BSP_LCD_V_RES - 1 - logical_x;
+	frame[panel_y * BSP_LCD_H_RES + panel_x] = color;
+}
+
+static void error_text(uint16_t *frame, const char *message, int x, int y, int scale, uint16_t color) {
+	for (const char *p = message; *p; ++p, x += 6 * scale) {
+		const uint8_t *glyph = error_glyph(*p);
+		if (!glyph) continue;
+		for (int row = 0; row < 7; ++row) {
+			for (int col = 0; col < 5; ++col) {
+				if (!(glyph[row] & (1 << (4 - col)))) continue;
+				for (int dy = 0; dy < scale; ++dy)
+					for (int dx = 0; dx < scale; ++dx)
+						error_pixel(frame, x + col * scale + dx, y + row * scale + dy, color);
+			}
+		}
+	}
+}
