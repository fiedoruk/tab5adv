diff --git a/backends/platform/esp32/components/tab5_tremor/tremor/doc/ov_time_seek_page.html b/backends/platform/esp32/components/tab5_tremor/tremor/doc/ov_time_seek_page.html
new file mode 100644
index 00000000..83cfefbd
